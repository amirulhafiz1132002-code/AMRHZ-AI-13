# Copy this file to Final.env for local development.
# Never commit Final.env or real credentials.

# Server configuration
HOST=127.0.0.1
PORT=8000
ENV=development

# AI / model configuration
MODEL_NAME=all-MiniLM-L6-v2
USE_LOCAL_MODEL=true
OPENAI_API_KEY=
HUGGINGFACE_API_KEY=

# Vector memory (RAG)
VECTOR_DB=faiss
VECTOR_DIM=384
MEMORY_PATH=./data/memory.json

# Agent system
ENABLE_MULTI_AGENT=true
AGENT_MODE=standard

# Voice system
ENABLE_VOICE=true
VOICE_ENGINE=pyttsx3

# Frontend / AP1 connection
FRONTEND_URL=http://localhost:3000
API_BASE_URL=http://localhost:8000

# Deployment
DEPLOY_ENV=local
RENDER=false
RAILWAY=false

# Security
# Set a unique, strong value locally if the application actually consumes this setting.
API_KEY=
# Restrict this to the exact frontend origins needed by your environment.
ALLOW_ORIGINS=http://localhost:3000

# Auto learning
AUTO_LEARN=true
SAVE_HISTORY=true
